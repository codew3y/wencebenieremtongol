.vite/
remotion/out/

# Secrets. Credentials live in Vercel's environment variables, never in the
# repo; `vercel env pull` writes them to .env.local, which this keeps out.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
.vercel/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors and OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.sw?
