{
  "name": "wence-hero-ad",
  "private": true,
  "description": "Remotion source for the wencetongol.vercel.app hero reel (light and dark).",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "node scripts/render.mjs",
    "render:dark": "node scripts/render.mjs dark",
    "render:light": "node scripts/render.mjs light",
    "preview": "node scripts/preview.mjs",
    "poster:dark": "remotion still src/index.ts HeroAd-dark out/dark/poster.png --frame=0",
    "poster:light": "remotion still src/index.ts HeroAd-light out/light/poster.png --frame=0",
    "contrast": "node scripts/contrast.mjs",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@remotion/cli": "4.0.535",
    "@remotion/fonts": "4.0.535",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "4.0.535",
    "simple-icons": "^16.35.0"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.535",
    "@remotion/renderer": "4.0.535",
    "@types/react": "^19.3.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2"
  }
}
